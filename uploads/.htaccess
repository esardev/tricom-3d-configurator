# TRICOM — uploads/: fajlovi otpremljeni iz administracije.
# Služe se samo slike i PDF; ništa se ne izvršava (PHP, CGI, SSI, skripte).

# 1) Sve zabranjeno …
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>

# 2) … osim dozvoljenih tipova (bez SVG-a: može da nosi skriptu).
<FilesMatch "\.(?i:jpe?g|png|webp|pdf)$">
  <IfModule mod_authz_core.c>
    Require all granted
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Allow from all
  </IfModule>
</FilesMatch>

# 3) Bez izvršavanja, i kad bi fajl sa takvim imenom nekako stigao ovde —
#    i sa „dvostrukom“ ekstenzijom (npr. slika.php.jpg), koju bi server sa
#    AddHandler .php inače izvršio. Administracija daje samo nasumična imena
#    sa jednom ekstenzijom, pa ovo ne pogađa nijedan pravi fajl.
<FilesMatch "\.(?i:php\d*|phtml|phar|pht|phps|cgi|pl|py|sh|asp|aspx|jsp|shtml|html?|svgz?|js)(\.|$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
# Svaki fajl ovde se služi kao običan fajl, bez PHP/CGI obrađivača.
# (default-handler, ne „None“: proba sa Apache 2.4 + AddHandler/Action je
# pokazala da None i RemoveHandler ne sprečavaju izvršavanje slika.php.jpg.)
<FilesMatch ".">
  SetHandler default-handler
</FilesMatch>
<IfModule mod_mime.c>
  RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .cgi .pl .py .shtml
  RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Content-Security-Policy "default-src 'none'; img-src 'self'; style-src 'unsafe-inline'; sandbox"
</IfModule>
