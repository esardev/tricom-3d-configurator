# TRICOM — Apache (koren sajta); administracija je u admin/ (PHP)
# Nepostojeća adresa → strana 404 (404.php; en/404.php preko en/.htaccess), sa
# statusom 404; <base> u njoj vodi putanje od korena sajta. Sajt u podfolderu:
# ovde upisati /podfolder/404.php (ErrorDocument ne zna za relativne putanje).
ErrorDocument 404 /404.php

# Kompresija teksta (HTML, CSS, JS, SVG, JSON, XML)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Keširanje: strane se uvek proveravaju, ostalo nedelju (CSS/JS) ili mesec (slike, fontovi).
# Imena fajlova nemaju otisak verzije — posle izmene CSS/JS pregledač ih osvežava najkasnije za 7 dana.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
</IfModule>

# Sve javne strane su PHP (app/site/) na istim .html adresama kao ranije —
# prepisuju se samo ove tačne putanje; css/, js/, assets/ i uploads/ se služe
# direktno. Direktan /index.php, /proizvodi.php … vodi 301 na javnu adresu
# (bez petlje: prepisani zahtev zadržava .html adresu); /index.html daje istu
# stranu kao / (canonical je /). robots.txt i sitemap.xml su takođe iz PHP-a.
# Pravila su relativna (bez RewriteBase), pa važe i kad je sajt u podfolderu.
# detalji/<slug>.html: proizvod, usluga ili mogućnost plazme iz baze.
# Engleske adrese su u en/.htaccess.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Kanonski domen https://tricom.rs (isti blok je i u en/.htaccess, jer pravila
  # iz ovog fajla ne važe u fascikli koja ima sopstveni RewriteEngine).
  # Stari tricom.co.rs, www.tricom.co.rs i www.tricom.rs → 301 na istu putanju i
  # upit na https://tricom.rs; http://tricom.rs → https://. Cilj se nikad ne
  # poklapa sa uslovom, pa nema petlje; drugi domeni (npr. lokalna proba) se ne diraju.
  # Preduslov: stari domeni pokazuju na ovu fasciklu i svi imaju HTTPS sertifikat.
  RewriteCond %{HTTP_HOST} ^(www\.)?tricom\.co\.rs\.?(:\d+)?$ [NC,OR]
  RewriteCond %{HTTP_HOST} ^www\.tricom\.rs\.?(:\d+)?$ [NC]
  RewriteRule ^ https://tricom.rs%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTP_HOST} ^tricom\.rs\.?(:\d+)?$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://tricom.rs%{REQUEST_URI} [R=301,L]

  RewriteRule ^(index\.html)?$ index.php [L]
  RewriteRule ^o-nama\.html$ o-nama.php [L]
  RewriteRule ^galerija\.html$ galerija.php [L]
  RewriteRule ^kontakt\.html$ kontakt.php [L]
  RewriteRule ^plazma\.html$ plazma.php [L]
  RewriteRule ^kalkulatori\.html$ kalkulatori.php [L]
  RewriteRule ^konfigurator\.html$ konfigurator.php [L]
  RewriteRule ^404\.html$ 404.php [L]
  RewriteRule ^proizvodi\.html$ proizvodi.php [L]
  RewriteRule ^usluge\.html$ usluge.php [L]
  RewriteRule ^reference\.html$ reference.php [L]
  RewriteRule ^detalji/([a-z0-9-]+)\.html$ detalji.php?slug=$1 [L]
  RewriteRule ^js/items\.js$ items-js.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^robots\.txt$ robots.php [L]
</IfModule>

# Privatni fajlovi: SQL, dnevnici, dokumentacija, rezervne kopije i skriveni
# fajlovi se nikad ne služe (bilo gde na sajtu). Folderi app/, database/ i
# _tools/ imaju i sopstveni .htaccess koji zatvara ceo folder.
<FilesMatch "(^\.|\.(?i:sql|md|log|bak|old|orig|swp|ini|dist|sh|lock|env)$|~$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
